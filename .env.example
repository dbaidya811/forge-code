# OpenRouter API Key (sk-or-v1-...)
# You can generate an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default Execution Mode: auto | auto_free | manual
FORGE_DEFAULT_MODE=auto_free

# Optional default model override (used when mode is set to manual)
# Example: anthropic/claude-3.5-sonnet, deepseek/deepseek-r1:free
FORGE_DEFAULT_MODEL=deepseek/deepseek-r1:free